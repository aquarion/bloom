{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "files": {
        "includes": [
            "resources/**/*.{js,jsx,ts,tsx,json,css}",
            "!resources/js/actions",
            "!resources/js/components/ui",
            "!resources/js/routes",
            "!resources/js/wayfinder",
            "!resources/branding/bloom.icon/icon.json"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "rules": {
            "nursery": {
                "useTailwindSortedClasses": {
                    "level": "warn",
                    "fix": "safe"
                }
            }
        }
    },
    "tailwind": {
        "mergeFunctions": ["cn", "clsx"],
        "variantFunctions": ["cva"]
    }
}
